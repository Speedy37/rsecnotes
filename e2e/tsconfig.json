{
	// Playwright tests, run by Node (with page.evaluate code run in the browser)
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts"]
}
